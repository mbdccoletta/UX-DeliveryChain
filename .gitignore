# Dependencies
node_modules/

# Build output
dist/
out/

# Dynatrace app toolkit state — build cache, logs, and .tokens.json, which
# holds the live app_token and toolkit_token for the environment. Never committed.
.dt-app/

# Which environment this checkout points at. The repository is public, so the
# environment URL is a local fact, not a committed one: DT_APP_ENVIRONMENT_URL
# here overrides the placeholder in app.config.json (flag > env > file).
.env
.env.*
!.env.example

# macOS
.DS_Store
*.log

# Replay scenarios are built from customer captures (HAR): screen names,
# countries, counts. They stay on this machine — never committed.
tools/replay/scenarios/
*.har
